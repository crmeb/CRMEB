# ============================================================
# CRMEB 生产环境配置模板
# 复制为 .env 后按实际环境修改
# ============================================================

# 生产环境必须为 false
APP_DEBUG=false

[APP]
TIMEZONE=UTC
OVERSEAS_MODE=1

[DATABASE]
TYPE=mysql
# 生产环境：使用内网地址或托管服务地址，禁止公网直连
HOSTNAME=127.0.0.1
HOSTPORT=3306
DATABASE=crmeb
USERNAME=crmeb
# 生产环境：使用强密码（至少16位，含大小写字母、数字、特殊字符）
PASSWORD=change_me_strong_password
PREFIX=eb_
CHARSET=utf8mb4
DEBUG=false

[CACHE]
# file / redis
DRIVER=file
CACHE_PREFIX=c:
CACHE_TAG_PREFIX=CRMEB:

[REDIS]
# 生产环境：使用内网地址或托管服务地址
REDIS_HOSTNAME=127.0.0.1
PORT=6379
# 生产环境：必须设置密码
REDIS_PASSWORD=change_me_redis_password
SELECT=0

[QUEUE]
QUEUE_NAME=

[LANG]
default_lang=en-us

[SECURITY]
ALLOW_CUSTOM_CRONTAB_CODE=false

[COOKIE]
# 生产环境必须配置（二选一）：
# 方式1：设置主域名（同主域/子域放行）
# 例：example.com 或 .example.com
DOMAIN=example.com

[CORS]
# 方式2：精确 Origin 白名单（优先级高于 COOKIE.DOMAIN）
# 完整 Origin 格式，逗号分隔
# 例：https://admin.example.com,https://www.example.com
ALLOWED_ORIGINS=
