APP_DEBUG=false

[APP]
TIMEZONE=UTC
OVERSEAS_MODE=1

[DATABASE]
TYPE=mysql
HOSTNAME=127.0.0.1
HOSTPORT=3306
DATABASE=crmeb
USERNAME=crmeb
PASSWORD=change_me
PREFIX=eb_
CHARSET=utf8mb4
DEBUG=false

[CACHE]
# file / redis
DRIVER=file
CACHE_PREFIX=c:
CACHE_TAG_PREFIX=CRMEB:

[REDIS]
REDIS_HOSTNAME=127.0.0.1
PORT=6379
REDIS_PASSWORD=
SELECT=0

[QUEUE]
QUEUE_NAME=

[LANG]
default_lang=en-us

[SECURITY]
ALLOW_CUSTOM_CRONTAB_CODE=false

[COOKIE]
# 生产建议设置为你的主域名（用于跨域放行判断与 Cookie 域控制）
# 例：example.com 或 .example.com
DOMAIN=

[CORS]
# 允许的 Origin 白名单（完整 Origin，逗号分隔），优先级高于 COOKIE.DOMAIN
# 例：https://admin.example.com,https://api.example.com
ALLOWED_ORIGINS=
