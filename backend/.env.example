# =====================================================================
# 后端环境配置模板（手动部署用）
# 用法：复制本文件为 backend/.env，然后按实际环境修改。
#
# 注意：
# - 使用仓库自带 Docker（./run.sh install）时无需此操作，
#   仓库内 backend/.env 已是容器默认配置（MySQL/Redis 主机为容器名）。
# - APP_KEY 建议替换为随机 32 位十六进制字符串。
# - 生产环境务必：APP_DEBUG = false，并修改数据库/Redis 密码。
# =====================================================================

APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
APP_KEY = app_key_REPLACE_WITH_RANDOM_HEX

[DATABASE]
TYPE = mysql
# 本机手动部署填 127.0.0.1；仓库自带 Docker 填容器名 crmeb_mysql
HOSTNAME = 127.0.0.1
# 仓库自带 Docker 宿主机端口为 33061，容器内为 3306
HOSTPORT = 3306
DATABASE = crmeb
USERNAME = crmeb
PASSWORD = 123456
PREFIX = eb_
CHARSET = utf8mb4
DEBUG = false

[LANG]
default_lang = zh-cn

[CACHE]
DRIVER = redis
# 多套环境共用同一 Redis 时需区分前缀
CACHE_PREFIX = cache_change_me:
CACHE_TAG_PREFIX = cache_tag_change_me:

[REDIS]
# 本机手动部署填 127.0.0.1；仓库自带 Docker 填容器名 crmeb_redis
REDIS_HOSTNAME = 127.0.0.1
# 仓库自带 Docker 宿主机端口为 63791，容器内为 6379
PORT = 6379
REDIS_PASSWORD = 123456
SELECT = 0

[QUEUE]
# 队列名前缀，多套环境共用同一 Redis 时需区分
QUEUE_NAME = change_me
