page{background-color:#fff}.OrderCancellation{width:100%;height:100%;background:#fff}.OrderCancellation .header{width:100%;height:300rpx;background-color:var(--view-theme);background-image:linear-gradient(180deg,var(--view-theme) 0%,#fff 100%);display:flex;align-items:flex-start;justify-content:flex-start;padding:72rpx 48rpx 0;box-sizing:border-box}.OrderCancellation .header .header-title{font-size:56rpx;font-weight:600;color:#fff;letter-spacing:4rpx;line-height:1.2;text-align:left}.OrderCancellation .whiteBg{width:690rpx;background:#fff;border-radius:20rpx;margin:-120rpx auto 0;padding:50rpx 40rpx;box-shadow:0 10rpx 40rpx rgba(0,0,0,.06);position:relative;z-index:2}.OrderCancellation .whiteBg .input{background:#f5f5f5;border-radius:12rpx;padding:24rpx 28rpx}.OrderCancellation .whiteBg .input input{font-size:30rpx;text-align:center}.OrderCancellation .whiteBg .bnt{margin-top:40rpx;height:86rpx;line-height:86rpx;text-align:center;border-radius:43rpx;background:var(--view-theme);color:#fff;font-size:30rpx;font-weight:500}.OrderCancellation .scan{margin:80rpx auto 0;width:280rpx;height:280rpx}.OrderCancellation .scan image{width:100%;height:100%}.WriteOff{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:560rpx;background:#fff;border-radius:20rpx;z-index:100;padding:40rpx 36rpx 48rpx;text-align:center}.WriteOff .pictrue{width:160rpx;height:160rpx;margin:0 auto 24rpx;border-radius:12rpx;overflow:hidden}.WriteOff .pictrue image{width:100%;height:100%}.WriteOff .num{font-size:28rpx;color:#333;font-weight:500}.WriteOff .title{margin-top:12rpx;font-size:26rpx;color:#666}.WriteOff .tip{margin:36rpx 0 28rpx;font-size:30rpx;color:#333}.WriteOff .btn{height:80rpx;line-height:80rpx;border-radius:40rpx;font-size:28rpx}.WriteOff .btn.sure{background:var(--view-theme);color:#fff}.WriteOff .btn.cancel{margin-top:20rpx;background:#f5f5f5;color:#666}.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99}