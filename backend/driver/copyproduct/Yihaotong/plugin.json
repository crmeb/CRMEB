{
    "key": "yihaotong",
    "name": "一号通采集",
    "description": "一号通采集驱动",
    "version": "1.0.0",
    "author": "CRMEB",
    "type": "driver",
    "path": "driver/copyproduct/Yihaotong",
    "default_install": true,
    "require": {
        "crmeb": "^8.0",
        "php": "^8.0"
    },
    "driver": {
