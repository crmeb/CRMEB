# 本文件只影响未跟踪文件；已有跟踪项不会因新增规则自动退出仓库。

# 以 "." 开头的目录全部忽略，保留仓库根目录 .crmeb/
.*/
!/.crmeb/
!/.crmeb/**

# backend 本地文件与目录
/backend/tests/
/backend/public/uploads/
/backend/public/install.lock
/backend/public/install/install.log
/backend/runtime/
/backend/public/phpExcel/
/backend/.constant
/backend/.env
# vendor 内第三方库运行期日志（如 workerman）
/backend/vendor/**/*.log

# frontend/admin 本地文件与构建产物
/frontend/admin/dist/
/frontend/admin/node_modules/
/frontend/admin/.env
/frontend/admin/.env.dev

# frontend/uni-app 本地文件与构建产物
/frontend/uni-app/dist/
/frontend/uni-app/node_modules/
/frontend/uni-app/.env
/frontend/uni-app/.env.development

#docker
/docker/mysql/data/*
/docker/mysql/log/*
.DS_Store
