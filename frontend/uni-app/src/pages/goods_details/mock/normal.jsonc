    // ===== 地图与门店 =====
    "mapKey": "TXABCD-1234-EFGH-5678-IJKL", // 腾讯地图API密钥（用于门店自提定位展示）
    "store_self_mention": 1,      // 是否支持门店自提 0否/1是

    // ===== 营销活动 activity（商品参与的营销活动列表） =====
    // 结构：活动对象数组，每项包含活动类型/标题/活动价/状态
    "activity": [
      { "id": 1, "type": "seckill", "title": "限时秒杀", "price": "79.00", "status": 1 }, // type活动类型seckill秒杀/bargain砍价/combination拼团/integral积分；status状态0未开始/1进行中/2已结束
      { "id": 2, "type": "bargain", "title": "砍价抢购", "price": "89.00", "status": 1 }
    ],

    // ===== 优惠券 coupons（可领取的优惠券列表） =====
    // 结构：优惠券对象数组，每项包含券名/面额/使用门槛/剩余量
    "coupons": [
      { "id": 501, "title": "满99减10", "coupon_price": "10.00", "use_min_price": "99.00", "surplus": 100 }, // id券ID/title名称/coupon_price面额/use_min_price满减门槛/surplus剩余领取数量
      { "id": 502, "title": "满199减30", "coupon_price": "30.00", "use_min_price": "199.00", "surplus": 50 }
    ],

    "routine_contact_type": 0,    // 客服联系类型 0无客服/1小程序客服/2H5客服/3外部链接

    // ===== 详情页区块配置 display_sections（前端动态渲染区块契约） =====
    // 结构：区块对象数组，每个section定义一个详情页展示区块，按order排序渲染
    "display_sections": [
      {
        "key": "spec",            // 区块标识 spec规格预览/fulfillment配送服务/after_sale售后保障
        "component": "spec_preview", // 渲染组件名 spec_preview规格预览组件/info_card信息卡片组件
        "visible": true,          // 是否可见 true可见/false隐藏
        "order": 10,              // 渲染顺序（数值越小越靠前）
        "data": {                 // 区块数据
          "blocks": [             // 区块内子块数组
            {
              "type": "matrix",   // 子块类型 matrix矩阵表格/list列表/card卡片
              "title": "规格预览", // 子块标题
              "attrs": [          // 规格属性数组
                { "name": "颜色", "values": ["黑色", "白色", "藏青"] }, // name属性名/values可选值数组
                { "name": "尺码", "values": ["S", "M", "L", "XL"] }
              ],
              "skus": [           // SKU预览数组（用于矩阵展示部分SKU的库存与价格）
                { "suk": "黑色,S", "price": 99, "stock": 20, "image": "https://demo.crmeb.com/static/images/products/normal-tshirt-black.jpg" }, // suk规格组合/price价格(number)/stock库存/image图片
                { "suk": "黑色,M", "price": 99, "stock": 15, "image": "https://demo.crmeb.com/static/images/products/normal-tshirt-black.jpg" },
                { "suk": "黑色,L", "price": 109, "stock": 8, "image": "https://demo.crmeb.com/static/images/products/normal-tshirt-black.jpg" },
                { "suk": "白色,S", "price": 99, "stock": 12, "image": "https://demo.crmeb.com/static/images/products/normal-tshirt-white.jpg" },
                { "suk": "白色,M", "price": 99, "stock": 10, "image": "https://demo.crmeb.com/static/images/products/normal-tshirt-white.jpg" },
                { "suk": "藏青,S", "price": 105, "stock": 4, "image": "https://demo.crmeb.com/static/images/products/normal-tshirt-navy.jpg" },
                { "suk": "藏青,M", "price": 105, "stock": 6, "image": "https://demo.crmeb.com/static/images/products/normal-tshirt-navy.jpg" }
              ]
            }
          ]
        }
      },
      {
        "key": "fulfillment",     // 区块标识：配送服务
        "component": "info_card", // 渲染组件：信息卡片
        "title": "配送服务",       // 区块标题
        "visible": true,
        "order": 20,
        "data": {                 // 区块数据（info_card组件用items数组）
          "items": [              // 信息项数组
            { "label": "物流", "value": "快递发货", "icon": "express" },   // label标签/value值/icon图标名
            { "label": "运费", "value": "包邮", "icon": "free" },
            { "label": "自提", "value": "支持到店自提", "icon": "pickup" },
            { "label": "发货地", "value": "浙江 杭州", "icon": "location" }
          ]
        }
      },
      {
        "key": "after_sale",      // 区块标识：售后保障
        "component": "info_card", // 渲染组件：信息卡片
        "title": "售后保障",       // 区块标题
        "visible": true,
        "order": 30,
        "data": {
          "items": [
            { "label": "售后类型", "value": "退款 / 退货退款 / 换货 / 维修", "icon": "after_sale" }, // 实物商品支持完整售后流程
            { "label": "售后期限", "value": "7天无理由", "icon": "deadline" },                       // normal产品类型售后期限7天
            { "label": "退款方式", "value": "原路退回", "icon": "refund" }
          ]
        }
      }
    ]
  }
}
